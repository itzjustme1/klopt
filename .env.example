# Copy to .env.production (and .env for npm run dev) to switch accounts on.
# Both values are public by design; supabase/schema.sql's row level security protects the data.
# Never put the service_role / secret key here.
VITE_ACCOUNT_URL=https://YOUR-PROJECT.supabase.co
VITE_ACCOUNT_KEY=YOUR-ANON-OR-PUBLISHABLE-KEY
